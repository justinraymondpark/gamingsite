{
  "name": "gamingsite-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test lib/bgg.test.js lib/device.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,hosting",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions:boardgames",
    "logs": "firebase functions:log --only boardgames"
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.24",
    "typescript": "^5.9.3"
  }
}
